{
  "name": "@tty-pt/hyle-bud",
  "version": "1.2.0",
  "type": "module",
  "description": "Universal Node.js and Browser bindings for libhyle-bud Schema-to-Bud UI Bridge",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cap": {
      "default": "./dist/hyle-cap.js"
    }
  },
  "files": [
    "dist",
    "include",
    "*.pc",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e 'console.log(\"@tty-pt/hyle-bud built\")'",
    "test": "node --test tests/hyle-bud.test.mjs"
  },
  "peerDependencies": {
    "@tty-pt/bud": ">=1.3.0",
    "@tty-pt/hyle": ">=1.7.2"
  },
  "devDependencies": {
    "@tty-pt/bud": "^1.3.0",
    "@tty-pt/hyle": "^1.7.2"
  },
  "keywords": [
    "hyle-bud",
    "libhyle-bud",
    "bud",
    "hyle",
    "schema",
    "bridge",
    "table"
  ],
  "author": "Paulo Quirino",
  "license": "BSD-2-Clause"
}
